DATABASE_URL="file:./dev.db"
PORT=3001
STORE_FRONTEND_URL="http://localhost:3000"

# Ambiente de execução (development | production)
NODE_ENV="development"

# Credenciais iniciais do Administrador (usadas apenas na criação inicial do banco)
# Em produção na VPS, defina uma senha forte ou deixe em branco para gerar uma senha aleatória segura
ADMIN_DEFAULT_EMAIL="admin@comandosartigosmilitares.com"
ADMIN_DEFAULT_PASSWORD=""

# O JWT_SECRET DEVE SER MODIFICADO PARA UMA STRING ALEATÓRIA SEGURA EM PRODUÇÃO!
JWT_SECRET="comandos_store_enterprise_super_secret_key_2026_change_in_production"

# === CONFIGURAÇÃO GOOGLE DRIVE BACKUP SYNC ===
# Opção 1: Caminho local da pasta do Google Drive para Desktop no Windows (Exemplo: G:\Meu Drive\BackupsComandosStore)
GOOGLE_DRIVE_SYNC_PATH=""

# Opção 2: API do Google Cloud (Service Account)
GOOGLE_DRIVE_CLIENT_EMAIL=""
GOOGLE_DRIVE_PRIVATE_KEY=""
GOOGLE_DRIVE_FOLDER_ID=""
